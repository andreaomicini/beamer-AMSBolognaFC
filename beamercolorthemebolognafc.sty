\mode<presentation>

%%%% Setting base colour
%% Bologna Blue #1A2F48
\definecolor{bolognafcblue}{RGB}{26,47,72}
%% Bologna Red #A21C26	
\definecolor{bolognafcred}{RGB}{162,28,38}
%% Bologna White #FFFFFF	
\definecolor{bolognafcwhite}{RGB}{255,255,255}
%% Bologna Silver #ECECEC	
\definecolor{bolognafcsilver}{RGB}{236,236,236}
%% Base colour for slides
\definecolor{basecolour}{RGB}{26,47,72} % Bologna Blue
%%%%

\setbeamercolor{section in toc}{fg=bolognafcblue!10!black,bg=white}
\setbeamercolor{alerted text}{fg=bolognafcblue!80!gray}
\setbeamercolor*{palette primary}{fg=bolognafcblue!60!black,bg=gray!30!white}
\setbeamercolor*{palette secondary}{fg=bolognafcblue!70!black,bg=gray!15!white}
\setbeamercolor*{palette tertiary}{bg=bolognafcblue!80!black,fg=gray!10!white}
\setbeamercolor*{palette quaternary}{fg=bolognafcblue,bg=gray!5!white}

\setbeamercolor*{sidebar}{fg=bolognafcblue,bg=gray!15!white}

\setbeamercolor*{palette sidebar primary}{fg=bolognafcblue!10!black}
\setbeamercolor*{palette sidebar secondary}{fg=white}
\setbeamercolor*{palette sidebar tertiary}{fg=bolognafcblue!50!black}
\setbeamercolor*{palette sidebar quaternary}{fg=gray!10!white}

\setbeamercolor{titlelike}{parent=palette primary,fg=bolognafcblue}
\setbeamercolor{frametitle}{bg=gray!10!white}
\setbeamercolor{frametitle right}{bg=gray!60!white}

\setbeamercolor*{separation line}{fg=bolognasilver}
\setbeamercolor*{fine separation line}{fg=bolognasilver}

\mode
<all>