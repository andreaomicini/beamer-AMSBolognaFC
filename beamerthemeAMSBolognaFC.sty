\mode<presentation>
%
% APICe BibTeX field display enabled: a publication's marker or (since 1.10) a
% talk's or a thesis's. The marker carries its own trailing gap,
% outside the link so the hotspot stops at the word: the .bst appends two spaces
% after \apicepubpar, but BibTeX wraps the .bbl line there and the newline
% collapses them into one \tiny space, which the DOI runs into
\if@doApice
\newcommand{\apicepubpar}[1]{{\textcolor{bolognafcsilver!90!black}{\tiny\href{https://\ams@apice@host@pub.apice.unibo.it/#1}{\textsf{APICe}}\mbox{~~~}}}}
\newcommand{\apicetalkpar}[1]{{\textcolor{bolognafcsilver!90!black}{\tiny\href{https://\ams@apice@host@talk.apice.unibo.it/#1}{\textsf{APICe}}\mbox{~~~}}}}
% a thesis has no short host that works yet: its full address
\newcommand{\apicethesispar}[1]{{\textcolor{bolognafcsilver!90!black}{\tiny\href{https://apice.unibo.it/bin/view/Thesis/#1}{\textsf{APICe}}\mbox{~~~}}}}
\else
\newcommand{\apicepubpar}[1]{}
\newcommand{\apicetalkpar}[1]{}
\newcommand{\apicethesispar}[1]{}
\fi
%
\setbeamertemplate{navigation symbols}{}
%
\useoutertheme{infolines}
\useinnertheme[shadow=true]{rounded}
%%% TO UNCOMMENT FOR LOCAL DIR
\usecolortheme{bolognafc}
% background -- plain by default; with bologna or cesena, a seal in grey cropped
% at the lower-right corner: the Ateneo with the former, the Campus di Cesena
% with the latter
\setbeamercolor{background canvas}{bg=bolognafcwhite}
\if@doSeal
  \if@doCesena
    \pgfdeclareimage[height=.97\paperheight]{bg}{almacesena-background}
  \else
    \pgfdeclareimage[height=.97\paperheight]{bg}{almabologna-background}
  \fi
  \setbeamertemplate{background}{\pgfuseimage{bg}}
\fi
% text
\setbeamercolor{normal text}{fg=bolognafcblue!10!black}
\setbeamercolor{alerted text}{fg=bolognafcred!90!black}
\setbeamercolor{quote}{fg=bolognafcblue!80!white}
% bullets
\setbeamercolor*{item}{fg=bolognafcred}
% front page
\setbeamercolor{title}{fg=bolognafcblue!90!black}
\setbeamercolor{subtitle}{fg=bolognafcblue!90!white}
\setbeamercolor{author}{fg=bolognafcred!90!black}
\setbeamercolor{institute}{fg=bolognafcblue!75!black}
\setbeamercolor{date}{fg=bolognafcblue!75!white}
% block header
\setbeamercolor{block title}{use=structure,fg=bolognafcsilver!90!white,bg=bolognafcblue!75!black}
\setbeamercolor{block title alerted}{use=alerted text,fg=bolognafcsilver!50!white,bg=bolognafcblue!35!black}
\setbeamercolor{block title example}{use=example text,fg=bolognafcblue!30!black,bg=bolognafcblue!30!white}
% block body
\setbeamercolor{block body}{parent=normal text,use=block title,bg=bolognafcblue!2!white}
\setbeamercolor{block body alerted}{parent=normal text,use=block title alerted,bg=bolognafcblue!5!white}
\setbeamercolor{block body example}{parent=normal text,use=block title example,bg=bolognafcblue!7!white}
% table of content
\setbeamercolor{section in toc}{fg=bolognafcblue!40!black}
\setbeamercolor{subsection in toc}{fg=bolognafcblue!50!black}
% footnote
\setbeamercolor{footnote mark}{fg=bolognafcred!90!black}
\setbeamercolor{footnote}{fg=bolognafcblue!25!gray}
% biblio
\setbeamertemplate{bibliography item}{\insertbiblabel}
% the label is a pointer, not a bullet: without this it inherits item's red and
% collides with the title, which is red on purpose
\setbeamercolor{bibliography item}{fg=bolognafcblue!60!gray}
\setbeamercolor{bibliography entry author}{fg=bolognafcblue!90!black}
\setbeamercolor{bibliography entry title}{fg=bolognafcred!75!black} 
\setbeamercolor{bibliography entry location}{fg=bolognafcblue!75!gray} 
\setbeamercolor{bibliography entry note}{fg=bolognafcsilver!50!black}  
% abstract
\setbeamercolor*{abstract title}{fg=bolognafcblue}
\setbeamerfont*{abstract title}{family=\sffamily}
\setbeamercolor*{abstract}{fg=purple!50!black}
\setbeamerfont*{abstract}{family=\rmfamily,size=\small}
% surfaces: a block or alerted block title is dark, all else light.
% The paired commands take their colour from the surface; doubled = smaller
% (and quiet on a light surface) -- see README.md
\newif\ifams@dark
\newcommand{\ams@onsurface}[2]{\ifams@dark#2\else#1\fi}% light, dark
% the quiet colour: faint on white, darker on the tinted example title
\newcommand{\ams@quiet}{bolognafcsilver!80!black}
% Citation -- faint on a light surface, light on a dark one; \cccite = \ccite.
% #1 colour, #2 optional note (-NoValue- when absent), #3 keys.  \cite[]{...}
% is not \cite{...} -- it typesets an empty note -- so the test is on the
% marker, not on emptiness.  The marker survives being passed down here.
\newcommand{\ams@cite}[3]{%
  \textcolor{#1}{\textsuperscript{\tiny\IfNoValueTF{#2}{\cite{#3}}{\cite[#2]{#3}}}}%
}
\NewDocumentCommand{\ccite}{o m}{\ams@cite{\ams@onsurface{\ams@quiet}{bolognafcsilver}}{#1}{#2}}
\NewDocumentCommand{\cccite}{o m}{\ams@cite{\ams@onsurface{\ams@quiet}{bolognafcsilver}}{#1}{#2}}
% the address of a URL or a DOI is stringed before it is used, so that a special
% character in it needs no escaping: \_ and a bare _ alike give one underscore.
% #1 receives #2 as a string with every backslash dropped -- see README.md
\newcommand{\ams@link@arg}{}
\ExplSyntaxOn
\cs_new_protected:Npn \ams_link_string:Nn #1#2
  {
    \tl_set:Nx #1 { \tl_to_str:n {#2} }
    \exp_args:NNo \tl_remove_all:Nn #1 \c_backslash_str
  }
\cs_new_eq:NN \ams@link@string \ams_link_string:Nn
\ExplSyntaxOff
% URL
\newcommand{\uurl}[1]{{\ams@link@string\ams@link@arg{#1}%
  \textcolor{\ams@onsurface{bolognafcred!75!black}{bolognafcsilver}}{\scriptsize\expandafter\url\expandafter{\ams@link@arg}}}}
\newcommand{\uuurl}[1]{{\ams@link@string\ams@link@arg{#1}%
  \textcolor{\ams@onsurface{\ams@quiet}{bolognafcsilver}}{\tiny\expandafter\url\expandafter{\ams@link@arg}}}}
% DOI -- https://doi.org is the current resolver; dx.doi.org is a deprecated
% alias, and the .bst reaches these through \dddoi, so this is the only place
% the resolver is named
\newcommand{\ddoi}[1]{{\ams@link@string\ams@link@arg{#1}%
  \textcolor{\ams@onsurface{bolognafcred!75!black}{bolognafcsilver}}{\scriptsize\href{https://doi.org/\ams@link@arg}{DOI:\ams@link@arg}}}}
\newcommand{\dddoi}[1]{{\ams@link@string\ams@link@arg{#1}%
  \textcolor{\ams@onsurface{\ams@quiet}{bolognafcsilver}}{\tiny\href{https://doi.org/\ams@link@arg}{DOI:\ams@link@arg}}}}
%% APICe addresses, printed short and linked: \apice{<kind>}{<Name>} for an
%% object, \apicesite{<alias>} for an alias host, \apicepage{<Space/Page>} for any
%% other page; [<text>] in front prints the text instead. Doubled: light, for dark
%% surfaces. The kinds and their short hosts are this one table -- see README.md
\newcommand{\ams@apice@host@pub}{pubs}
\newcommand{\ams@apice@host@talk}{talks}
\newcommand{\ams@apice@host@course}{courses}
\newcommand{\ams@apice@host@event}{events}
%% theses, journals, projects, products: a line each, once their short hosts
%% resolve page by page
\newcommand{\ams@apice@addr}{}
\newcommand{\ams@apice@obj}[2]{%
  \ifcsname ams@apice@host@#1\endcsname
    \ams@link@string\ams@link@arg{#2}%
    \edef\ams@apice@addr{\csname ams@apice@host@#1\endcsname.apice.unibo.it/\ams@link@arg}%
  \else
    \PackageError{beamerthemeAMSBolognaFC}{Unknown APICe kind `#1'}%
      {The kinds are pub, talk, course, event.}%
    \def\ams@apice@addr{apice.unibo.it}%
  \fi}
\newcommand{\ams@apice@show}[1]{\href{https://#1}{\nolinkurl{#1}}}
\newcommand{\ams@apice@text}[2]{\href{https://#1}{#2}}
%% #1 colour, #2 size, #3 the optional text or -NoValue-
\newcommand{\ams@apice@link}[3]{\textcolor{#1}{#2\IfNoValueTF{#3}%
  {\expandafter\ams@apice@show\expandafter{\ams@apice@addr}}%
  {\expandafter\ams@apice@text\expandafter{\ams@apice@addr}{#3}}}}
\NewDocumentCommand{\apice}{o m m}{{\ams@apice@obj{#2}{#3}\ams@apice@link{\ams@onsurface{bolognafcred!75!black}{bolognafcsilver}}{\scriptsize}{#1}}}
\NewDocumentCommand{\aapice}{o m m}{{\ams@apice@obj{#2}{#3}\ams@apice@link{\ams@onsurface{\ams@quiet}{bolognafcsilver}}{\tiny}{#1}}}
\NewDocumentCommand{\apicesite}{o m}{{\ams@link@string\ams@link@arg{#2}%
  \edef\ams@apice@addr{\ams@link@arg.apice.unibo.it}%
  \ams@apice@link{\ams@onsurface{bolognafcred!75!black}{bolognafcsilver}}{\scriptsize}{#1}}}
\NewDocumentCommand{\aapicesite}{o m}{{\ams@link@string\ams@link@arg{#2}%
  \edef\ams@apice@addr{\ams@link@arg.apice.unibo.it}%
  \ams@apice@link{\ams@onsurface{\ams@quiet}{bolognafcsilver}}{\tiny}{#1}}}
\NewDocumentCommand{\apicepage}{o m}{{\ams@link@string\ams@link@arg{#2}%
  \edef\ams@apice@addr{apice.unibo.it/bin/view/\ams@link@arg}%
  \ams@apice@link{\ams@onsurface{bolognafcred!75!black}{bolognafcsilver}}{\scriptsize}{#1}}}
\NewDocumentCommand{\aapicepage}{o m}{{\ams@link@string\ams@link@arg{#2}%
  \edef\ams@apice@addr{apice.unibo.it/bin/view/\ams@link@arg}%
  \ams@apice@link{\ams@onsurface{\ams@quiet}{bolognafcsilver}}{\tiny}{#1}}}
% emph -- in a block title, the title's own colour: italic only
\def\ams@emph@colour{bolognafcblue!50!black}
\renewcommand{\emph}[1]{\textcolor{\ams@emph@colour}{\textit{#1}}}
\addtobeamertemplate{block begin}{\def\ams@emph@colour{.}\ams@darktrue\setbeamercolor{alerted text}{fg=bolognafcsilver!90!black}}
  {\def\ams@emph@colour{bolognafcblue!50!black}\ams@darkfalse\setbeamercolor{alerted text}{fg=bolognafcred!90!black}}
\addtobeamertemplate{block alerted begin}{\def\ams@emph@colour{.}\ams@darktrue\setbeamercolor{alerted text}{fg=bolognafcsilver!90!black}}
  {\def\ams@emph@colour{bolognafcblue!50!black}\ams@darkfalse\setbeamercolor{alerted text}{fg=bolognafcred!90!black}}
\addtobeamertemplate{block example begin}{\def\ams@emph@colour{.}\def\ams@quiet{bolognafcblue!25!gray}}
  {\def\ams@emph@colour{bolognafcblue!50!black}\def\ams@quiet{bolognafcsilver!80!black}}
% alert 
%\renewcommand{\alert}[1]{\textcolor{bolognafcblue!90!black}{#1}}
\newcommand{\aalert}[1]{\textcolor{\ams@onsurface{bolognafcblue!25!gray}{bolognafcsilver!90!black}}{\it#1}}
% speaker -- both bold: the point is to stand out, and colour alone could not do
% it.  \speaker keeps its own colour for the title page; \sspeaker inherits its
% surface's colour, so it reads light on the footline and dark on a light surface
\newcommand{\speaker}[1]{\textcolor{bolognafcblue!75!red}{\textbf{#1}}}
\newcommand{\sspeaker}[1]{\textbf{#1}}
%
\usepackage[T1]{fontenc}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% workarounds -- handled here so that no document has to deal with them
%
% Commands that cannot survive hyperref's PDF-string expansion.  Without this,
% every deck would have to wrap them in \texorpdfstring by hand.
%   \speaker, \sspeaker -- mark the speaker's name on the title page.
%               \@firstofone keeps the name and drops only the markup, so the
%               author still reaches the PDF /Author field.
%   \ccite, \cccite -- a citation says nothing in a bookmark, so they go
%               entirely, note and all.  The replacement is expandable: an
%               unexpandable one (\NewDocumentCommand) would have hyperref drop
%               the name alone and leave "[note]{keys}" behind.
%   \translate -- beamer's translator hook.  \refname is \translate{References},
%               so \section*{\refname} warns "Token not allowed in a PDF
%               string".  \@firstofone keeps the argument, drops the command.
%   \\ -- a line break inside \title or \author, meaningless in a PDF string.
%               hyperref would drop it and run the two sides together, turning
%               "Nobody Else\\someone@unibo.it" into "Nobody Elsesomeone@unibo.it";
%               mapping it to a space keeps the metadata readable.
%   \uurl, \uuurl -- these carry \url, whose catcode machinery has no meaning in a
%               PDF string.  \@firstofone keeps the address and drops the styling.
%   \ddoi, \dddoi -- the number is worth having in the metadata, the resolver link
%               is not, so these become "DOI:<doi>".  A replacement is needed
%               rather than left out: the stringing above is unexpandable, so
%               hyperref drops it and leaves the rest of the body behind, putting
%               the DOI ahead of its own label.
%   \apicepubpar, \apicetalkpar, \apicethesispar -- a decorative marker, meaningless in a PDF string, so it is
%               dropped, argument and all.
\NewExpandableDocumentCommand{\ams@nocite}{o m}{}
\newcommand{\ams@nodoi}[1]{DOI:#1}
%% an APICe address in a bookmark: the text if one is given, else the address
\NewExpandableDocumentCommand{\ams@noapice}{o m m}{\IfNoValueTF{#1}{\csname ams@apice@host@#2\endcsname.apice.unibo.it/#3}{#1}}
\NewExpandableDocumentCommand{\ams@noapicesite}{o m}{\IfNoValueTF{#1}{#2.apice.unibo.it}{#1}}
\NewExpandableDocumentCommand{\ams@noapicepage}{o m}{\IfNoValueTF{#1}{apice.unibo.it/bin/view/#2}{#1}}
\ifdefined\pdfstringdefDisableCommands
  \pdfstringdefDisableCommands{%
    \let\speaker\@firstofone
    \let\sspeaker\@firstofone
    \let\ccite\ams@nocite
    \let\cccite\ams@nocite
    \let\uurl\@firstofone
    \let\uuurl\@firstofone
    \let\ddoi\ams@nodoi
    \let\dddoi\ams@nodoi
    \let\apicepubpar\@gobble
    \let\apicetalkpar\@gobble
    \let\apicethesispar\@gobble
    \let\apice\ams@noapice
    \let\aapice\ams@noapice
    \let\apicesite\ams@noapicesite
    \let\aapicesite\ams@noapicesite
    \let\apicepage\ams@noapicepage
    \let\aapicepage\ams@noapicepage
    \let\translate\@firstofone
    \let\\\space
  }
\fi
%
% Computer Modern Sans has no small-caps shape, so every \textsc under the
% default font -- \textsc{Alma Mater Studiorum} on a title page, say -- falls
% back to the SERIF small caps and warns "Font shape `T1/cmss/m/sc' in size <n>
% not available".  Declaring the substitution makes it official and silent at
% every size.  ssub* is a silent substitution and the typeset result is the one
% LaTeX was already producing, so nothing moves on the slides.
%
% To get genuine SANS small caps instead, load a font family that has them
% (Lato, Fira Sans, Linux Biolinum ...) -- but that restyles the whole deck and
% departs from the AMSBolognaFC identity, so it is deliberately not done here.
\DeclareFontShape{T1}{cmss}{m}{sc}{<->ssub*cmr/m/sc}{}
